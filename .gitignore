# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

!.env.example

# Local runtimes of Aprender: copied and hash-checked from node_modules by tools/runtimes/stage.mjs (licenses stay tracked).
/public/local-runtimes/bash/
/public/local-runtimes/python/
/public/local-runtimes/sql/
/public/toolchains/
/public/wasm-oj/
